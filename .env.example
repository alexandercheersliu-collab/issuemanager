# ===== MathMaster Edu 环境配置示例 =====
# 复制本文件为 .env 并按需修改；未配置 AI Key 时应用以演示模式运行

# ---------- AI 提供商 ----------
# openai_compatible = 任何 OpenAI 兼容服务（推荐，一套代码对接多家）
#   SiliconFlow:  https://api.siliconflow.cn/v1   模型示例: Qwen/Qwen2.5-VL-32B-Instruct
#   通义千问:      https://dashscope.aliyuncs.com/compatible-mode/v1  模型示例: qwen-vl-plus
#   智谱 GLM:     https://open.bigmodel.cn/api/paas/v4           模型示例: glm-4v-flash
#   DeepSeek / OpenAI / Ollama(http://localhost:11434/v1) 等同理
# gemini = Google Gemini（模型示例: gemini-2.0-flash）
# mock   = 演示模式（默认，无需 Key）
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_API_KEY=
AI_MODEL=Qwen/Qwen2.5-VL-32B-Instruct

# ---------- 数据库 ----------
# 留空 = SQLite 自动落在 {DATA_DIR}/math_tutor.db（默认，零配置）
# 切换 MySQL 示例：
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/math_tutor?charset=utf8mb4
# DATABASE_URL=

# ---------- 运行时数据目录（可选，默认项目内 data/）----------
# 把运行时数据放到项目外的独立数据盘（数据库 / 向量库 / 模型缓存 / 上传原图）：
# DATA_DIR=D:/workspace/learning-tour/data
# CHROMA_DIR=D:/workspace/learning-tour/data/chroma
# ChromaDB 内置嵌入模型 (all-MiniLM-L6-v2) 的 ONNX 缓存父目录；
# 留空 = 沿用其默认 ~/.cache/chroma/onnx_models
# CHROMA_MODEL_DIR=D:/workspace/learning-tour/data/models/onnx
# 文档（整卷导入）上传目录；留空 = <DATA_DIR>/uploads/docs（跟随 DATA_DIR）
# DOC_UPLOAD_PATH=D:/workspace/learning-tour/data/uploads/docs
# 分享卡片中文字体文件路径；留空 = 按平台自动探测，找不到回退 PIL 默认字体
# SHARE_CARD_FONT_PATH=C:/Windows/Fonts/msyh.ttc

# ---------- RAG 向量检索 ----------
# 嵌入模型双轨策略（远程优先，本地回退）：
#   配置 EMBEDDING_BASE_URL + EMBEDDING_API_KEY → 远程嵌入（默认模型 BAAI/bge-m3，
#   中文题干召回质量明显优于内置小模型，推荐生产使用）；
#   留空 → ChromaDB 内置本地 all-MiniLM-L6-v2（ONNX，零外部依赖，开箱即用）。
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=BAAI/bge-m3

# ---------- 重排（可选，混合检索精排）----------
# RERANK_BASE_URL=https://api.siliconflow.cn/v1
# RERANK_API_KEY=
# RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---------- 首次运行的种子账号 ----------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_DEMO_USERNAME=demo
SEED_DEMO_PASSWORD=demo123

# ---------- API 网关 (JWT) ----------
# 生产环境必须改为强随机密钥（>= 32 字节），例如：python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
# 令牌有效期（分钟），默认 7 天
# ACCESS_TOKEN_EXPIRE_MINUTES=10080
